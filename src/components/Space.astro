---
export interface Props {
  index: number;
  label: string;
  headline: string;
  cta?: string;
  ctaHref?: string;
  theme: string;
  image?: string | string[];
}

const { index, label, headline, cta, ctaHref, theme, image } = Astro.props;
const displayIndex = String(index + 1).padStart(2, '0');

const images = image
  ? Array.isArray(image)
    ? image
    : [image]
  : [];
const imageCount = images.length;
const isTiled = imageCount > 1;
---

<section
  class={`space ${theme}`}
  data-index={index}
>
  <div class="space-content">
    <div class="space-text">
      <span class="space-label font-sans">
        {label}
      </span>
      <h2 class="space-headline font-serif">
        {headline}
      </h2>
      <div class="space-body font-sans">
        <slot />
      </div>
      {cta && (
        <a href={ctaHref || '#'} class="space-cta">
          {cta}
          <span class="space-cta-arrow">&#8594;</span>
        </a>
      )}
    </div>
    <div class="space-visual">
      <div class={`space-visual-inner ${isTiled ? 'is-tiled' : ''} font-serif`}>
        {isTiled ? (
          images.map((src, i) => (
            <img src={src} alt="" loading="lazy" />
          ))
        ) : images.length === 1 ? (
          <img src={images[0]} alt="" loading="lazy" />
        ) : (
          <slot name="visual">{displayIndex}</slot>
        )}
      </div>
    </div>
  </div>
</section>
